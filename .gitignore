# ==========================================
# Environment Variables & API Keys (CRITICAL)
# ==========================================
.env
.env.*
!.env.example
secrets.toml
.streamlit/secrets.toml

# ==========================================
# Project-Specific Temporary & Database Files
# ==========================================
# Ignore local ChromaDB database files
data/chroma_db/*
!data/chroma_db/.gitkeep

# Ignore uploaded PDFs and temporary extracted charts
data/temp_uploads/*
!data/temp_uploads/.gitkeep
data/temp_images/*
!data/temp_images/.gitkeep

# Ignore general PDF or image files accidentally placed in root
*.pdf
*.png
*.jpg
*.jpeg

# ==========================================
# Python & Virtual Environments
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.python-version

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Distributions & Packages
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ==========================================
# IDE & System Files
# ==========================================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Desktop.ini

# IDEs & Editors
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo